# Salin file ini menjadi .env lalu isi nilainya. JANGAN commit file .env.
SECRET_KEY=ganti-dengan-string-acak-panjang
FLASK_DEBUG=1
# URL dasar aplikasi, dipakai untuk membuat link reset password (tanpa slash di akhir)
APP_BASE_URL=http://127.0.0.1:5000
# 0 = database kosong (default). Isi 1 hanya jika ingin data contoh untuk presentasi.
SEED_DEMO=0
# Akun Satpam awal (dibuat otomatis jika belum ada akun Satpam). GANTI sebelum dipakai sungguhan.
SECURITY_NAME=Satpam ITSB
SECURITY_EMAIL=satpam@itsb.test
SECURITY_PHONE=081200000000
SECURITY_PASSWORD=Satpam12345
# Aktifkan HTTPS-only cookie saat dipublikasikan dengan HTTPS
SESSION_COOKIE_SECURE=0

# ---- EmailJS ----
EMAILJS_SERVICE_ID=YOUR_SERVICE_ID
EMAILJS_PUBLIC_KEY=YOUR_PUBLIC_KEY
# Private Key (Account > API keys). Rahasia, hanya dipakai di backend.
EMAILJS_PRIVATE_KEY=YOUR_PRIVATE_KEY
EMAILJS_FEEDBACK_TEMPLATE_ID=YOUR_FEEDBACK_TEMPLATE_ID
EMAILJS_RESET_TEMPLATE_ID=YOUR_RESET_TEMPLATE_ID
